{
  "name": "chess-analyzer-pro",
  "productName": "Chess Analyzer Pro",
  "version": "1.1.0",
  "description": "Free chess game analysis software with the Stockfish engine built in",
  "main": "src/main.js",
  "license": "GPL-3.0-or-later",
  "author": "Chess Analyzer Pro",
  "scripts": {
    "bundle": "esbuild src/renderer/app.js --bundle --outfile=src/renderer/bundle.js --format=iife --target=chrome120",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win nsis --x64",
    "bundle:ext": "esbuild ../extension/src/content.js --bundle --outfile=../extension/content.js --format=iife --target=chrome110 --alias:chess.js=./node_modules/chess.js",
    "test": "node ../tools/test-analysis.mjs"
  },
  "dependencies": {
    "chess.js": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "pro.chessanalyzer.app",
    "productName": "Chess Analyzer Pro",
    "artifactName": "ChessAnalyzerProSetup.${ext}",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/engine.js",
      "src/renderer/index.html",
      "src/renderer/style.css",
      "src/renderer/bundle.js",
      "src/renderer/pieces/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pgn",
        "name": "PGN Chess Game",
        "description": "Chess game (PGN)",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Chess Analyzer Pro",
      "license": "../LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/after-pack.js"
  }
}
